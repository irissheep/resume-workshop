{
  "name": "resume-generator-agent",
  "version": "0.1.0",
  "description": "本地优先、用户自带模型的中文简历桌面应用",
  "private": true,
  "license": "MIT",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dist": "npm run build && electron-builder --win nsis zip --x64 --publish never",
    "licenses": "node scripts/licenses.mjs",
    "prepare:electron": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.2",
    "electron-builder": "26.15.3",
    "vitest": "5.0.3",
    "zod": "4.6.5",
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "6.1.1",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "esbuild": "0.28.2",
    "pdfjs-dist": "6.3.289"
  },
  "build": {
    "appId": "local.resume.generator",
    "productName": "Resume Workshop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "docs/THIRD_PARTY_LICENSES.txt"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": true,
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true
    },
    "artifactName": "Resume-Workshop-0.1.0-x64.${ext}"
  },
  "type": "module"
}
